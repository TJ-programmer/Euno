######################
# Node / package managers
######################

# Dependencies
node_modules/
.pnp
.pnp.js
.pnp.cjs
.pnp.mjs
.pnp.loader.mjs

# pnpm
.pnpm-debug.log*
.pnpm-store/
.lock-wscript

# Yarn / npm logs
yarn-debug.log*
yarn-error.log*
npm-debug.log*
lerna-debug.log*

######################
# Expo / React Native
######################

# Expo cache and generated types
.expo/
.expo-shared/
.expo/devices.json
.expo/types/
apps/mobile/.expo/
apps/mobile/.expo-shared/

# Expo web + export output
dist/
web-build/
apps/mobile/dist/
apps/mobile/web-build/

# Metro / compiler health checks
.metro-health-check*
apps/mobile/.metro-health-check*

# Expo signing credentials (never commit)
.expo-credentials.json
*.p12
*.p8
*.key
*.mobileprovision

# Native projects (managed workflow: generated by `expo prebuild`).
# Uncomment if you deliberately commit native code.
/android/
/ios/
apps/mobile/android/
apps/mobile/ios/

######################
# Build outputs
######################

build/
out/
coverage/
.nyc_output/
*.tsbuildinfo

######################
# Environment & secrets
######################

# Local env files (keep .env.example tracked)
.env
.env.*
!.env.example
!.env*.example

# Secret / service account key files
*.secrets.*
service-account*.json
firebase*.json
.secrets


######################
# Logs & temp
######################

logs/
*.log
*.tmp
*.temp

######################
# Editors & IDEs
######################

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.suo
*.njsproj
*.sln
*.swp
*.swo

######################
# OS
